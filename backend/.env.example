# CryptoFlow backend environment variables.
# Copy this file to `backend/.env` and fill in real values.
# NEVER commit the real .env — it is git-ignored.

# --- Core Django ---
# "True" enables Django debug mode (local dev only). Defaults to False (prod).
DEBUG=True
# Required when DEBUG=False. Generate one, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-to-a-long-random-secret

# --- Database ---
# If set, the app uses this (Postgres in production) via dj-database-url.
# If unset, it falls back to local SQLite (db.sqlite3) — fine for dev.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# --- External market-data APIs ---
# CoinGecko demo API key (spot prices / market listings).
COINGECKO_API_KEY=your-coingecko-demo-api-key

# --- Cloudinary (profile picture uploads) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# --- Deployment / hosts ---
# Heroku app name; its <name>.herokuapp.com host is auto-added to ALLOWED_HOSTS.
HEROKU_APP_NAME=your-heroku-app-name
# Deployed frontend origin (added to CORS_ALLOWED_ORIGINS).
DEPLOYED_FRONTEND_URL=https://your-frontend.example.com
# Deployed backend origin (added to CSRF_TRUSTED_ORIGINS).
DEPLOYED_BACKEND_URL=https://your-backend.example.com

# Comma-separated extras appended to the built-in lists.
ALLOWED_HOSTS=example.com,www.example.com
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
